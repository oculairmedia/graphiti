{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "CLAUDE_HOOK_EVENT=UserPromptSubmit $CLAUDE_PROJECT_DIR/.claude/hooks/graphiti-session-summary.py",
            "timeout": 1
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "CLAUDE_HOOK_EVENT=Stop $CLAUDE_PROJECT_DIR/.claude/hooks/graphiti-session-summary.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|Read|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "CLAUDE_HOOK_EVENT=PostToolUse $CLAUDE_PROJECT_DIR/.claude/hooks/graphiti-session-summary.py",
            "timeout": 1
          }
        ]
      }
    ]
  }
}
